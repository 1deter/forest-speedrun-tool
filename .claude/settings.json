{
  "permissions": {
    "deny": [
      "Artifact",
      "ReportFindings",
      "SearchPlugins",
      "SuggestPluginInstall",
      "SuggestSkills",
      "ScheduleWakeup",
      "mcp__visualize",
      "mcp__6f616b42-0ed8-571e-823f-ee4aca6b7ce9",
      "mcp__1a59c906-04da-521d-bda7-7f71b9f9e01c",
      "mcp__claude-in-chrome",
      "mcp__scheduled-tasks",
      "mcp__mcp-registry",
      "mcp__potassium",
      "mcp__roblox-explorer"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/session-start.py\" --hook",
            "timeout": 300,
            "statusMessage": "Session start report (git, baseline, release, site, tasks)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre_tool.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop.py\"",
            "timeout": 30,
            "statusMessage": "Checking for unfinished work (git, tags, tasks)"
          }
        ]
      }
    ]
  }
}
