<?xml version="1.0" encoding="utf-8"?>
<!-- The bot needs nuget.org only. Without <clear/> it inherits the repo root's
     BepInEx feed, and a BepInEx outage failed the bot's CI (NU1301, 2026-10-18). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
