<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The game-knowledge Discord bot (docs/knowledge-bot.md). A gateway bot:
    a runner asks with /ask, a mention or a reply to an answer; the answer
    is written by a free-tier model (Gemini first, any OpenAI-compatible
    provider as a fallback) from the knowledge base, found by a local
    search (SQLite FTS5 + a small ONNX embedding model) - nothing is sent
    anywhere just to search.

      forest-bot search "bomb boost fps"         (no model needed)
      forest-bot ask "why does a bomb boost work?"
      forest-bot                                 (the Discord bot)
    bot/README.md has the settings and the modes.

    The knowledge files ship with it (Content below); the decompiled game
    code is NOT in the repo - FOREST_BOT_CODE points at a private copy.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>forest-bot</AssemblyName>
    <RootNamespace>ForestBot</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <!-- The QA bot's message splitting, already tested there. -->
  <ItemGroup>
    <Compile Include="../../tools/BridgeMcp/DiscordText.cs" Link="Linked/DiscordText.cs" />
  </ItemGroup>

  <!-- The knowledge base, as the repo has it. -->
  <ItemGroup>
    <Content Include="../../knowledge/**/*.md" Link="kb/knowledge/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/game-notes.md;../../docs/savestates.md;../../docs/run-mode.md" Link="kb/docs/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../docs/fsm/*.txt" Link="kb/docs/fsm/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
