<?xml version="1.0" encoding="utf-8"?>
<!-- The site needs nuget.org only. Without <clear/> it inherits the repo root's
     BepInEx feed, so a BepInEx outage would fail the site's CI (NU1301, as the bot's did 2026-10-18). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
