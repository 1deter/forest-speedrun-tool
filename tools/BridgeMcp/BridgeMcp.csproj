<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev-time only. NOT part of the plugin build and never shipped.

    An MCP server (stdio) over the live test bridge: typed tools for the
    bridge's commands, screenshots returned as images, log search, the
    IL scanner, and closing / relaunching / updating the game. It speaks
    the same in.txt / out.txt protocol as scripts/bridge.sh, so the plugin
    needs no change. Registered for Claude Code in the repo's .mcp.json.

      dotnet build tools/BridgeMcp -c Release

    A running server holds its DLL: rebuild after the session's MCP
    server is stopped (/mcp -> restart), or the copy fails.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>forest-bridge-mcp</AssemblyName>
    <RootNamespace>ForestOverlay.BridgeMcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Screenshots are scaled with System.Drawing: Windows only, as is the game. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

</Project>
