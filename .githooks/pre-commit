#!/bin/sh
# The project's lints before every commit (docs/harness.md 5a): versions,
# the csproj Remove lines, the UI heuristics. Each failure says WHAT / WHY / FIX.
# First, a commit carrying tasks/tasks.jsonl gets the docs/tasks.md rendered
# from it staged too - CI fails main on a stale view (author 2026-10-18).
# Turned on by scripts/session-start.py (git config core.hooksPath .githooks).
PY=$(command -v python || command -v python3)
"$PY" scripts/tasks.py check --staged || exit 1
exec "$PY" scripts/lint.py
